#!/bin/sh
# Builds and runs integration/real_smtp.rb: one test message through the SMTP
# server named in the environment. See docs/real-smtp.md.
#   POSTAL_SMTP_HOST=smtp.example.com POSTAL_MAIL_FROM=me@example.com \
#   POSTAL_MAIL_TO=me@example.com POSTAL_SMTP_USER=... POSTAL_SMTP_PASSWORD=... \
#   script/check-real-smtp
set -eu
cd "$(dirname "$0")/.."
# On macOS the compiler does not look in Homebrew's keg-only OpenSSL: point it there.
if [ -z "${LIBRARY_PATH:-}" ] && command -v brew >/dev/null 2>&1; then
  if prefix=$(brew --prefix openssl@3 2>/dev/null) && [ -d "$prefix/lib" ]; then
    export LIBRARY_PATH="$prefix/lib" CPATH="$prefix/include"
  fi
fi
mkdir -p build
spinel -I . integration/real_smtp.rb -o build/real_smtp >/dev/null
# POSTAL_SMTP_CLASSICAL_GROUPS=1: see integration/classical-groups.cnf (a network that drops
# the large TLS hello of OpenSSL 3.5 makes the handshake hang until the timeout).
if [ "${POSTAL_SMTP_CLASSICAL_GROUPS:-}" = "1" ] && [ -z "${OPENSSL_CONF:-}" ]; then
  export OPENSSL_CONF="$PWD/integration/classical-groups.cnf"
fi
exec ./build/real_smtp
